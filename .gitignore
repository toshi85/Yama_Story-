# 生成した画像と、生成中の作業ファイル（2026-09-04）
# images/ は imagegen が作る中間素材で、これまでも1件も追跡していない（戸沢村は311枚で約580MB）。
# 正本はプロンプト側（Asset_Prompts_Full.md / image_queue.json）。
Scripts/*/images/
Scripts/*/.imagegen/
Scripts/*/.imagegen.lock

# 編集の中間生成物（再生成される・戸沢村の .render_cache だけで382MB。2026-09-09）
Scripts/*/.render_cache/
Scripts/*/.render_cache_preview/
Scripts/*/.map_tiles/
Scripts/*/.editing/
Scripts/*/check/frames/
Scripts/*/check/clips/
Scripts/*/check/preview/
Scripts/*/check/serve.pid

# 素材フォルダの動画・音声・画像（2026-09-12 追記）
# もともと一度も追跡していない（追跡済み0件）が、未追跡として2GB分が一覧に出て
# `git add -A` の事故を招くので明示的に外す。
Scripts/*/*.mp4
Scripts/*/*.wav
Scripts/*/*.mp3
Scripts/*/画像/
Scripts/*/動画/*.mp4
Scripts/*/地形図/*.mp4
Scripts/*/音声/**/*.wav
Scripts/*/音声/**/*.mp3
Scripts/*/check/**/*.mp4
Scripts/*/check/**/*.wav
Scripts/*/check/**/*.png
